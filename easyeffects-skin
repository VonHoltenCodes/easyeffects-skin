print_header() {
    echo -e "${CYAN}"
    cat << 'EOF'

 ██╗   ██╗ ██████╗ ███╗   ██╗██╗  ██╗ ██████╗ ██╗  ████████╗███████╗███╗   ██╗
 ██║   ██║██╔═══██╗████╗  ██║██║  ██║██╔═══██╗██║  ╚══██╔══╝██╔════╝████╗  ██║
 ██║   ██║██║   ██║██╔██╗ ██║███████║██║   ██║██║     ██║   █████╗  ██╔██╗ ██║
 ╚██╗ ██╔╝██║   ██║██║╚██╗██║██╔══██║██║   ██║██║     ██║   ██╔══╝  ██║╚██╗██║
  ╚████╔╝ ╚██████╔╝██║ ╚████║██║  ██║╚██████╔╝███████╗██║   ███████╗██║ ╚████║
   ╚═══╝   ╚═════╝ ╚═╝  ╚═══╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚═╝   ╚══════╝╚═╝  ╚═══╝
EOF
    echo -e "${MAGENTA}"
    cat << 'EOF'
  ██████╗ ██████╗ ██████╗ ███████╗███████╗
 ██╔════╝██╔═══██╗██╔══██╗██╔════╝██╔════╝
 ██║     ██║   ██║██║  ██║█████╗  ███████╗
 ██║     ██║   ██║██║  ██║██╔══╝  ╚════██║
 ╚██████╗╚██████╔╝██████╔╝███████╗███████║
  ╚═════╝ ╚═════╝ ╚═════╝ ╚══════╝╚══════╝
EOF
    echo ""
    echo -e "${GREEN}  ╔═══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}  ║${NC}  ${YELLOW}Easy Effects Skin Manager${NC} ${CYAN}v1.0${NC}                      ${GREEN}║${NC}"
    echo -e "${GREEN}  ║${NC}  ${BLUE}WinAmp-style skins for your Linux audio experience!${NC}  ${GREEN}║${NC}"
    echo -e "${GREEN}  ╚═══════════════════════════════════════════════════════════╝${NC}"
    echo ""
}

# List available skins
list_skins() {
    print_header
    echo -e "${CYAN}Available skins:${NC}\n"

    local current_skin=$(get_current_skin)

    for skin_file in "$SKIN_DIR"/*.css; do
        if [ -f "$skin_file" ]; then
            skin_name=$(basename "$skin_file" .css)

            # Show indicator for current skin
            if [ "$skin_name" == "$current_skin" ]; then
                echo -e "  ${GREEN}▶${NC} ${YELLOW}$skin_name${NC} ${GREEN}(active)${NC}"
            else
                echo -e "    $skin_name"
            fi

            # Show skin description
            case $skin_name in
                "onkyo-green")
                    echo -e "      ${BLUE}└─${NC} 1980s Onkyo receiver: Brushed aluminum + green LEDs"
                    ;;
                "red-black")
                    echo -e "      ${BLUE}└─${NC} Racing-inspired: Carbon fiber + red LEDs"
                    ;;
                "glass-future")
                    echo -e "      ${BLUE}└─${NC} Modern minimalist: Frosted glass + blue accents"
                    ;;
                "cyberpunk")
                    echo -e "      ${BLUE}└─${NC} Synthwave outrun: Neon pink/cyan/purple"
                    ;;
                "woodgrain")
                    echo -e "      ${BLUE}└─${NC} Vintage 1970s: Wood panels + warm amber"
                    ;;
            esac
            echo ""
        fi
    done
}

# Get current skin name
get_current_skin() {
    if [ -L "$ACTIVE_CSS" ]; then
        # If it's a symlink, get the target
        local target=$(readlink "$ACTIVE_CSS")
        basename "$target" .css
    elif [ -f "$ACTIVE_CSS" ]; then
        # Try to detect from CSS content
        local header=$(head -n 3 "$ACTIVE_CSS" | grep -o "THEME")
        if grep -q "ONKYO" "$ACTIVE_CSS"; then
            echo "onkyo-green"
        elif grep -q "RED/BLACK" "$ACTIVE_CSS"; then
            echo "red-black"
        elif grep -q "GLASS FUTURE" "$ACTIVE_CSS"; then
            echo "glass-future"
        elif grep -q "CYBERPUNK" "$ACTIVE_CSS"; then
            echo "cyberpunk"
        elif grep -q "WOODGRAIN" "$ACTIVE_CSS"; then
            echo "woodgrain"
        else
            echo "unknown"
        fi
    else
        echo "none"
    fi
}

# Apply a skin
apply_skin() {
    local skin_name="$1"
    local skin_file="$SKIN_DIR/${skin_name}.css"

    # Check if skin exists
    if [ ! -f "$skin_file" ]; then
        echo -e "${RED}✗ Skin '${skin_name}' not found!${NC}"
        echo -e "${YELLOW}Run 'easyeffects-skin list' to see available skins.${NC}"
        exit 1
    fi

    echo -e "${CYAN}Applying skin: ${YELLOW}${skin_name}${NC}"

    # Copy skin CSS to active location
    cp "$skin_file" "$ACTIVE_CSS"
    echo -e "${GREEN}✓ CSS applied${NC}"

    # Apply spectrum colors if defined
    if [ -n "${SPECTRUM_COLORS[$skin_name]}" ]; then
        echo -e "${CYAN}Setting spectrum color...${NC}"
        flatpak run --command=sh com.github.wwmm.easyeffects -c \
            "gsettings set com.github.wwmm.easyeffects.spectrum color '(${SPECTRUM_COLORS[$skin_name]})'" 2>/dev/null
        echo -e "${GREEN}✓ Spectrum color set${NC}"
    fi

    # Apply axis label colors if defined
    if [ -n "${AXIS_COLORS[$skin_name]}" ]; then
        flatpak run --command=sh com.github.wwmm.easyeffects -c \
            "gsettings set com.github.wwmm.easyeffects.spectrum color-axis-labels '(${AXIS_COLORS[$skin_name]})'" 2>/dev/null
    fi

    # Restart Easy Effects
    echo -e "${CYAN}Restarting Easy Effects...${NC}"

    # Kill Easy Effects (ignore error if not running)
    echo -e "${CYAN}Stopping Easy Effects...${NC}"
    if pkill -9 -f easyeffects 2>/dev/null; then
        echo -e "${GREEN}✓ Easy Effects stopped${NC}"
    else
        echo -e "${YELLOW}⚠ Easy Effects was not running${NC}"
    fi
    sleep 1

    # Start Easy Effects in background service mode (no GUI)
    echo -e "${CYAN}Starting Easy Effects in background...${NC}"
    nohup flatpak run --command=easyeffects com.github.wwmm.easyeffects --gapplication-service >/dev/null 2>&1 &
    disown
    sleep 1

    echo -e "${GREEN}✓ Easy Effects started in background${NC}"
    echo -e "\n${GREEN}Skin '${skin_name}' applied successfully!${NC}"
}

# Show current skin
show_current() {
    local current=$(get_current_skin)
    print_header
    echo -e "${CYAN}Current skin:${NC} ${YELLOW}${current}${NC}\n"
}

# Interactive menu
interactive_menu() {
    print_header

    # Get current skin
    local current=$(get_current_skin)
    echo -e "${CYAN}Current skin:${NC} ${YELLOW}${current}${NC}\n"

    # Build skin list array
    local skin_files=()
    local skin_names=()
    local skin_descriptions=()
    local index=1

    for skin_file in "$SKIN_DIR"/*.css; do
        if [ -f "$skin_file" ]; then
            local skin_name=$(basename "$skin_file" .css)
            skin_files+=("$skin_file")
            skin_names+=("$skin_name")

            # Get description
            local desc=""
            case $skin_name in
                "onkyo-green")
                    desc="1980s Onkyo receiver: Brushed aluminum + green LEDs"
                    ;;
                "red-black")
                    desc="Racing-inspired: Carbon fiber + red LEDs"
                    ;;
                "glass-future")
                    desc="Modern minimalist: Frosted glass + blue accents"
                    ;;
                "cyberpunk")
                    desc="Synthwave outrun: Neon pink/cyan/purple"
                    ;;
                "woodgrain")
                    desc="Vintage 1970s: Wood panels + warm amber"
                    ;;
            esac
            skin_descriptions+=("$desc")
        fi
    done

    # Display menu
    echo -e "${CYAN}Select a skin:${NC}\n"
    for i in "${!skin_names[@]}"; do
        local num=$((i + 1))
        local marker=""
        if [ "${skin_names[$i]}" == "$current" ]; then
            marker=" ${GREEN}(current)${NC}"
        fi
        echo -e "  ${YELLOW}$num)${NC} ${skin_names[$i]}$marker"
        echo -e "     ${BLUE}${skin_descriptions[$i]}${NC}"
        echo ""
    done

    echo -e "  ${YELLOW}0)${NC} Exit\n"

    # Get user selection
    read -p "$(echo -e ${CYAN}Enter selection [0-${#skin_names[@]}]:${NC} )" choice

    # Validate and apply
    if [ "$choice" == "0" ]; then
        echo -e "${YELLOW}Exiting...${NC}"
        exit 0
    elif [ "$choice" -ge 1 ] && [ "$choice" -le "${#skin_names[@]}" ] 2>/dev/null; then
        local selected_index=$((choice - 1))
        local selected_skin="${skin_names[$selected_index]}"
        echo ""
        apply_skin "$selected_skin"
    else
        echo -e "${RED}✗ Invalid selection${NC}"
        exit 1
    fi
}

# Show usage
show_usage() {
    print_header
    cat << EOF
${CYAN}Usage:${NC}
  easyeffects-skin ${YELLOW}[command]${NC} ${BLUE}[options]${NC}

${CYAN}Interactive Mode:${NC}
  ${YELLOW}easyeffects-skin${NC}     Run without arguments for interactive menu

${CYAN}Commands:${NC}
  ${YELLOW}menu${NC}                 Launch interactive menu
  ${YELLOW}list${NC}                 List all available skins
  ${YELLOW}current${NC}              Show currently active skin
  ${YELLOW}apply${NC} ${BLUE}<skin>${NC}          Apply a specific skin
  ${YELLOW}help${NC}                 Show this help message

${CYAN}Available skins:${NC}
  • onkyo-green        1980s Onkyo receiver style
  • red-black          Racing-inspired red & black
  • glass-future       Modern glass with blue tints
  • cyberpunk          Neon synthwave pink/cyan
  • woodgrain          Vintage 1970s wood panels

${CYAN}Examples:${NC}
  easyeffects-skin              # Interactive menu
  easyeffects-skin list         # List all skins
  easyeffects-skin apply cyberpunk
  easyeffects-skin current

${CYAN}Quick switches:${NC}
  easyeffects-skin onkyo-green
  easyeffects-skin red-black
  easyeffects-skin glass-future
  easyeffects-skin cyberpunk
  easyeffects-skin woodgrain

EOF
}

# Main script logic
main() {
    # Ensure skin directory exists
    mkdir -p "$SKIN_DIR"

    # Parse command (default to interactive menu if no args)
    case "${1:-menu}" in
        menu|interactive)
            interactive_menu
            ;;
        list|ls)
            list_skins
            ;;
        current|show)
            show_current
            ;;
        apply)
            if [ -z "$2" ]; then
                echo -e "${RED}✗ Error: No skin specified${NC}"
                echo -e "${YELLOW}Usage: easyeffects-skin apply <skin>${NC}"
                exit 1
            fi
            apply_skin "$2"
            ;;
        help|-h|--help)
            show_usage
            ;;
        onkyo-green|red-black|glass-future|cyberpunk|woodgrain)
            # Quick switch - skin name as direct command
            apply_skin "$1"
            ;;
        *)
            echo -e "${RED}✗ Unknown command: $1${NC}"
            echo -e "${YELLOW}Run 'easyeffects-skin help' for usage information.${NC}"
            exit 1
            ;;
    esac
}

# Run main
main "$@"
