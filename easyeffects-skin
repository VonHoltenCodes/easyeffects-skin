#!/bin/bash
# ============================================
# Easy Effects Skin Manager
# Manage and switch between custom skins (like WinAmp!)
# ============================================

SKIN_DIR="$HOME/.var/app/com.github.wwmm.easyeffects/config/gtk-4.0/themes"
ACTIVE_CSS="$HOME/.var/app/com.github.wwmm.easyeffects/config/gtk-4.0/gtk.css"

# Skin spectrum color definitions (R, G, B, Alpha)
declare -A SPECTRUM_COLORS=(
    ["onkyo-green"]="0.6, 1.0, 0.0, 1.0"
    ["red-black"]="1.0, 0.2, 0.0, 1.0"
    ["glass-future"]="0.4, 0.6, 1.0, 1.0"
    ["cyberpunk"]="1.0, 0.0, 1.0, 1.0"
    ["woodgrain"]="0.8, 0.5, 0.0, 1.0"
)

# Skin axis label color definitions
declare -A AXIS_COLORS=(
    ["onkyo-green"]="0.7, 0.7, 0.7, 1.0"
    ["red-black"]="0.7, 0.7, 0.7, 1.0"
    ["glass-future"]="0.6, 0.7, 0.9, 1.0"
    ["cyberpunk"]="0.0, 1.0, 1.0, 1.0"
    ["woodgrain"]="1.0, 0.67, 0.0, 1.0"
)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

